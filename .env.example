# Copy this to .env for local dev (the .gitignore already excludes .env),
# or set the same variables in your deploy target's secret/env panel
# (FastAPI Cloud, Render, Vercel).
#
# Never paste a real token into config.py — that file is committed to git.

# ENTSO-E Transparency Platform API token.
# Get from: transparency.entsoe.eu -> My Account -> Web API Security Token
# (only appears after ENTSO-E approves your "Restful API access" request).
# Required by ingestion/entsoe_client.py. The live API does NOT need it —
# it serves from precomputed model files committed in data/models/.
ENTSOE_API_KEY=
